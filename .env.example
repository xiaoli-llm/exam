# Offline mock requires no environment variables.
# This file is documentation only; the CLI does not auto-load .env files.
# Ollama: http://localhost:11434 ; compatible: provider base URL including /v1
MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=your-installed-model
# Only needed when your model service requires authentication.
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
# Optional provider extension, supported by DeepSeek; leave unset for other services.
MODEL_THINKING=disabled
